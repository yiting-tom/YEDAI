# 真實 OKF 語料絕不進版控
data/
bundles/
corpus/

# 索引快取與查詢日誌（完整日誌含查詢原文，不可外流）
.index/
logs/

# 合成語料輸出
synthetic/
.synthetic/

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/

# 本機設定覆寫
config.local.yaml
dictionary.local.yaml

# 實體來源 CSV。真實的機台／腔體／缺陷清單本身就是敏感資料——
# 這個 repo 是公開的，所以這條是硬性條件，不是慣例。
*.local.csv

# 識別碼格式樣本。樣本就是真實識別碼，同上。
*-samples.local.yaml

# taxonomy 判斷方法與 defect / module 清單。
# defect shape → module 的對照本身就是 fab taxonomy，比識別碼樣式更敏感——
# 樣式只洩漏形狀，這裡洩漏的是製程知識本身。repo 內只留 schema 與範例。
*.local.yaml

# OS
.DS_Store

# 瀏覽器自動化測試產物。截圖是拿本機服務跑出來的，會隨語料一起變動——
# 進版控只會得到一張永遠對不上現況的圖。
.playwright-mcp/
docs-*.png

# CodeGraph 本機索引。內容是這台機器上的原始碼衍生物，不是專案資產。
.codegraph/

# Claude Code 本機設定
.claude/settings.local.json

# API 金鑰。這個 repo 是公開的——金鑰進版控等同外洩。
.env
.env.*
!.env.example

# 產生的查詢清單。內含真實識別碼，同 corpus 一樣不得進版控。
*.local.txt

# LLM 產生的評估集。查詢是語料衍生物，含真實識別碼。
*.local.jsonl
